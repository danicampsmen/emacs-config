\begin{exercise}
Se busca minimizar $f(x) = x - \ln(x - 1) + \ln(\frac{19}{3} - x)$.
\end{exercise}

\begin{solution}
Derivadas de la función:
\begin{align*}
    f'(x) &= 1 - \frac{1}{x-1} + \frac{1}{19/3 - x} \\
    f''(x) &= \frac{1}{(x-1)^2} + \frac{1}{(19/3 - x)^2}
\end{align*}
\textbf{(a) Puntos notables:}
Igualando $f'(x) = 0$, obtenemos $3x^2 - 22x + 35 = 0$. Las raíces son $x = 5$ (Máximo local, ya que $f'' < 0$) y $x = 7/3$ (Mínimo local, $f'' > 0$).
Para la inflexión, $f''(x) = 0 \implies (x-1)^2 = (19/3 - x)^2 \implies x = 11/3$.

\textbf{(b) Constante de Lipschitz $L$ para $f''$ en $[2,3]$:}
\begin{equation*}
    f'''(x) = -\frac{2}{(x-1)^3} + \frac{2}{(19/3 - x)^3}
\end{equation*}
En el intervalo $[2,3]$, la magnitud de esta derivada es máxima en $x=2$. Evaluando:
\begin{equation*}
    L = \absolute{f'''(2)} = \frac{2}{1^3} + \frac{2}{(13/3)^3} = 2 + \frac{54}{2197} \approx 2.0245
\end{equation*}

\textbf{(c) Radio $\beta$:}
La cota para garantizar contracción cuadrática requiere $\beta < \frac{2}{M L}$, donde $M = \max \absolute{1/f''(x)} = 4$.
Por lo tanto, $\beta < \frac{2}{4 \times 2.0245} \approx 0.2469$. Podemos tomar $\beta = 0.246$.

\textbf{(d) Iteraciones desde $x_0 = 2.5$:}
\begin{itemize}
    \item $x_1 = 2.5 - \frac{0.07246}{0.37639} \approx 2.30748$
    \item $x_2 = 2.30748 - \frac{-0.0135}{0.5234} \approx 2.33328$
    \item $x_3 = 2.33328 - \frac{-0.00002}{0.5} \approx 2.33332$
\end{itemize}
$x_3$ está sumamente cerca de $\bar{x} = 7/3 \approx 2.33333$. La convergencia cuadrática es evidente.
\end{solution}

