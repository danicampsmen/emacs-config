\begin{exercise}
Minimizar $f(x_1, x_2) = -12x_2 + 4x_1^2 + 4x_2^2 + 4x_1 x_2$.
\end{exercise}

\begin{solution}
El gradiente y la Hessiana $Q$ son:
\begin{equation*}
    \nabla f(x) = \begin{pmatrix} 8x_1 + 4x_2 \\ 4x_1 + 8x_2 - 12 \end{pmatrix}, \quad Q = \begin{pmatrix} 8 & 4 \\ 4 & 8 \end{pmatrix}
\end{equation*}
\textbf{(a) Direcciones Q-conjugadas:}
Buscamos $d^0, d^1$ tales que $(d^0)^T Q d^1 = 0$. Elegimos $d^0 = (1,0)^T$.
\begin{equation*}
    (1,0) \begin{pmatrix} 8 & 4 \\ 4 & 8 \end{pmatrix} \begin{pmatrix} x \\ y \end{pmatrix} = 8x + 4y = 0 \implies y = -2x
\end{equation*}
Podemos escoger $d^1 = (1,-2)^T$.

\textbf{(b) Minimización con $x_0 = (-1,0)^T$:}
\begin{equation*}
    \alpha_0 = -\frac{(d^0)^T \nabla f(x_0)}{(d^0)^T Q d^0} = -\frac{-8}{8} = 1 \implies x_1 = x_0 + 1(d^0) = \begin{pmatrix} 0 \\ 0 \end{pmatrix}
\end{equation*}
\begin{equation*}
    \alpha_1 = -\frac{(d^1)^T \nabla f(x_1)}{(d^1)^T Q d^1} = -\frac{-24}{24} = 1 \implies x_2 = x_1 + 1(d^1) = \begin{pmatrix} -1 \\ 2 \end{pmatrix}
\end{equation*}

\textbf{(c) Gradiente conjugado desde $x_0 = (-1,-2)^T$:}
\begin{itemize}
    \item $d^0 = -\nabla f(x_0) = (16, 32)^T$. Paso: $\alpha_0 = \frac{1280}{14336} = \frac{5}{56}$.
    \item $x_1 = x_0 + \alpha_0 d^0 = (3/7, 6/7)^T$. Gradiente: $\nabla f(x_1) = (48/7, -24/7)^T$.
    \item Coeficiente $\beta_0 = \frac{\norm{\nabla f(x_1)}^2}{\norm{\nabla f(x_0)}^2} = \frac{9}{196}$.
    \item Nueva dirección $d^1 = -\nabla f(x_1) + \beta_0 d^0 = (-300/49, 240/49)^T$.
    \item Paso $\alpha_1 = 7/30$. Nuevo iterado $x_2 = (-1, 2)^T$. (Mínimo exacto en 2 pasos).
\end{itemize}
\end{solution}

