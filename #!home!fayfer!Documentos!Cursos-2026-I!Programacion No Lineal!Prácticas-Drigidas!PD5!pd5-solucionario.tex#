\begin{exercise}
Consideremos la función $f(x) = \frac{1}{2}x_1^2 + \frac{1}{4}x_2^4 - \frac{1}{2}x_2^2$.
\begin{enumerate}[(a)]
    \item Determinar y clasificar los puntos estacionarios de $f$;
    \item Partiendo de $x^0 = (1,0)^T$, realizar una iteración del método del gradiente;
    \item Analizar la posible convergencia de la sucesión $(x^k)$, generada por el método del gradiente a partir del punto $x^0$ dado en el apartado anterior.
\end{enumerate}
\end{exercise}

\begin{solution}
\textbf{Parte (a):} Un punto es estacionario si $\nabla f(x) = 0$.
Calculamos el gradiente:
\begin{equation*}
    \nabla f(x) = \begin{pmatrix} x_1 \\ x_2^3 - x_2 \end{pmatrix} = \begin{pmatrix} 0 \\ 0 \end{pmatrix}
\end{equation*}
De aquí, $x_1 = 0$ y $x_2(x_2^2 - 1) = 0 \implies x_2 \in \{0, 1, -1\}$. 
Los puntos estacionarios son: $(0,0)$, $(0,1)$ y $(0,-1)$.

Para clasificarlos, calculamos la matriz Hessiana:
\begin{equation*}
    \nabla^2 f(x) = \begin{pmatrix} 1 & 0 \\ 0 & 3x_2^2 - 1 \end{pmatrix}
\end{equation*}
\begin{itemize}
    \item En $(0,0)$: $\nabla^2 f(0,0) = \begin{pmatrix} 1 & 0 \\ 0 & -1 \end{pmatrix}$. Autovalores $1, -1$. Es una matriz \textbf{indefinida}. El punto es un \textbf{punto de silla}.
    \item En $(0,1)$: $\nabla^2 f(0,1) = \begin{pmatrix} 1 & 0 \\ 0 & 2 \end{pmatrix}$. Autovalores $1, 2$. Es \textbf{definida positiva}. El punto es un \textbf{mínimo local estricto}.
    \item En $(0,-1)$: $\nabla^2 f(0,-1) = \begin{pmatrix} 1 & 0 \\ 0 & 2 \end{pmatrix}$. Autovalores $1, 2$. Es \textbf{definida positiva}. El punto es un \textbf{mínimo local estricto}.
\end{itemize}

\textbf{Parte (b):} El método del gradiente es $x^{k+1} = x^k - \alpha_k \nabla f(x^k)$.
En $x^0 = (1,0)^T$, el gradiente es $\nabla f(1,0) = (1, 0)^T$. La dirección es $d^0 = (-1, 0)^T$.
Realizamos minimización exacta para hallar $\alpha_0$:
\begin{equation*}
    \min_{\alpha} f(x^0 + \alpha d^0) = f(1-\alpha, 0) = \frac{1}{2}(1-\alpha)^2
\end{equation*}
Derivando e igualando a cero: $-(1-\alpha) = 0 \implies \alpha_0 = 1$.
El nuevo punto es:
\begin{equation*}
    x^1 = \begin{pmatrix} 1 \\ 0 \end{pmatrix} - 1 \begin{pmatrix} 1 \\ 0 \end{pmatrix} = \begin{pmatrix} 0 \\ 0 \end{pmatrix}
\end{equation*}

\textbf{Parte (c):} En la siguiente iteración evaluamos $\nabla f(x^1) = \nabla f(0,0) = (0,0)^T$. 
Como el gradiente es nulo, el algoritmo se detiene. La sucesión converge en exactamente 1 iteración. Sin embargo, converge al punto $(0,0)$, el cual es un \textbf{punto de silla} y no un minimizador.
\end{solution}

