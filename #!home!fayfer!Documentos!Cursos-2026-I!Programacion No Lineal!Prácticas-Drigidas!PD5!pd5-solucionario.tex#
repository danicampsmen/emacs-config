\begin{exercise}
Demuestre que el método de Newton para resolver $x^2 - a = 0$ viene dado por $x^{k+1} = \frac{1}{2}\left(x^k + \frac{a}{x^k}\right)$. Realice tres iteraciones para calcular $\sqrt{5}$, con $x^0 = 2$.
\end{exercise}

\begin{solution}
La ecuación iterativa del método de Newton clásico para hallar raíces de $\Phi(x) = 0$ es:
\begin{equation*}
    x^{k+1} = x^k - \frac{\Phi(x^k)}{\Phi'(x^k)}
\end{equation*}
Para $\Phi(x) = x^2 - a$, la derivada es $\Phi'(x) = 2x$. Sustituyendo:
\begin{equation*}
    x^{k+1} = x^k - \frac{(x^k)^2 - a}{2x^k} = x^k - \frac{x^k}{2} + \frac{a}{2x^k} = \frac{x^k}{2} + \frac{a}{2x^k} = \frac{1}{2}\left( x^k + \frac{a}{x^k} \right)
\end{equation*}
Calculando $\sqrt{5}$ ($a=5$) partiendo de $x^0 = 2$:
\begin{itemize}
    \item \textbf{Iteración 1:} $x^1 = \frac{1}{2}\left( 2 + \frac{5}{2} \right) = \frac{9}{4} = 2.25$
    \item \textbf{Iteración 2:} $x^2 = \frac{1}{2}\left( \frac{9}{4} + \frac{5}{9/4} \right) = \frac{1}{2}\left( \frac{9}{4} + \frac{20}{9} \right) = \frac{161}{72} \approx 2.236111$
    \item \textbf{Iteración 3:} $x^3 = \frac{1}{2}\left( \frac{161}{72} + \frac{360}{161} \right) = \frac{51841}{23184} \approx 2.23606797$
\end{itemize}
\end{solution}

