% PROBLEMA 2
% ---------------------------------------------------------
\begin{exercise}
Resuelva el problema $\min \nabla f(x_k)^T d$ sujeto a $\norm{d}_2 = 1$ empleando las condiciones de KKT.
\end{exercise}

\begin{solution}
Sea $c = \nabla f(x_k)$. El problema equivale a minimizar $c^T d$ sujeto a $d^T d - 1 = 0$.
Definimos la función Lagrangiana:
\begin{equation*}
    L(d, \lambda) = c^T d + \lambda(d^T d - 1)
\end{equation*}
Las condiciones de primer orden de KKT son:
\begin{itemize}
    \item $\nabla_d L = c + 2\lambda d = 0 \implies d = -\frac{1}{2\lambda} c$
    \item $d^T d = 1$
\end{itemize}
Sustituyendo $d$ en la restricción:
\begin{equation*}
    \left(-\frac{1}{2\lambda} c\right)^T \left(-\frac{1}{2\lambda} c\right) = \frac{\norm{c}_2^2}{4\lambda^2} = 1 \implies 2\lambda = \pm \norm{c}_2
\end{equation*}
Esto genera dos puntos estacionarios: $d_1 = -\frac{c}{\norm{c}_2}$ y $d_2 = \frac{c}{\norm{c}_2}$.
Evaluando la función objetivo en ambos:
\begin{itemize}
    \item Para $d_1$: $c^T d_1 = - \frac{\norm{c}_2^2}{\norm{c}_2} = -\norm{c}_2$ (Mínimo).
    \item Para $d_2$: $c^T d_2 = \frac{\norm{c}_2^2}{\norm{c}_2} = \norm{c}_2$ (Máximo).
\end{itemize}
El minimizador global es $d^* = -\frac{\nabla f(x_k)}{\norm{\nabla f(x_k)}_2}$, es decir, la dirección del máximo descenso normalizada.
\end{solution}

