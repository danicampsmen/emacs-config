% PROBLEMA 11
% ---------------------------------------------------------
\begin{exercise}
Demuestre que el minimizador de una cuadrática $f$ en la variedad afín $V = \{\bar{x} + S\gamma\}$ es $x^+ = \bar{x} - S(S^T AS)^{-1}S^T \nabla f(\bar{x})$.
\end{exercise}

\begin{solution}
Sustituimos $x = \bar{x} + S\gamma$ en $f(x)$:
\begin{equation*}
    \tilde{f}(\gamma) = \frac{1}{2}\gamma^T (S^T A S)\gamma + \nabla f(\bar{x})^T S\gamma + f(\bar{x})
\end{equation*}
El mínimo irrestricto respecto a $\gamma$ se da cuando $\nabla \tilde{f}(\gamma) = 0$:
\begin{equation*}
    (S^T A S)\gamma^* + S^T \nabla f(\bar{x}) = 0 \implies \gamma^* = -(S^T A S)^{-1} S^T \nabla f(\bar{x})
\end{equation*}
Sustituyendo $\gamma^*$ para obtener $x^+$:
\begin{equation*}
    x^+ = \bar{x} - S(S^T A S)^{-1} S^T \nabla f(\bar{x})
\end{equation*}
Verificamos el gradiente en $x^+$:
\begin{align*}
    S^T \nabla f(x^+) &= S^T(A x^+ + b) = S^T(A\bar{x} + b + AS\gamma^*) \\
    &= S^T \nabla f(\bar{x}) + S^T A S (-(S^T A S)^{-1} S^T \nabla f(\bar{x})) \\
    &= S^T \nabla f(\bar{x}) - S^T \nabla f(\bar{x}) = 0
\end{align*}
\end{solution}

