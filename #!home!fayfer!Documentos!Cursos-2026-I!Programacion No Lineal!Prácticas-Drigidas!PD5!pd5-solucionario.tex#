% PROBLEMA 6
% ---------------------------------------------------------
\begin{exercise}
Sea $f(x) = \frac{1}{2}(x_1^2 - x_2)^2 + \frac{1}{2}(1 - x_1)^2$. ¿Cuál es el minimizador? Itere Newton para minimizar desde $x^0 = (2,2)^T$. Evalúe si es un buen paso.
\end{exercise}

\begin{solution}
\textbf{1. Minimizador exacto:} Al ser una suma de cuadrados, su mínimo es cero, lo cual se cumple si $x_1^2 = x_2$ y $x_1 = 1$. El minimizador global es $x^* = (1,1)^T$.

\textbf{2. Iteración de Newton:} 
El gradiente y la matriz Hessiana son:
\begin{align*}
    \nabla f(x) &= \begin{pmatrix} 2x_1(x_1^2 - x_2) - (1 - x_1) \\ -(x_1^2 - x_2) \end{pmatrix} \\
    \nabla^2 f(x) &= \begin{pmatrix} 6x_1^2 - 2x_2 + 1 & -2x_1 \\ -2x_1 & 1 \end{pmatrix}
\end{align*}
Evaluando en $x^0 = (2,2)^T$:
\begin{equation*}
    \nabla f(2,2) = \begin{pmatrix} 9 \\ -2 \end{pmatrix}, \quad \nabla^2 f(2,2) = \begin{pmatrix} 21 & -4 \\ -4 & 1 \end{pmatrix}
\end{equation*}
Invertimos la matriz Hessiana ($\det = 5$):
\begin{equation*}
    [\nabla^2 f(2,2)]^{-1} = \frac{1}{5} \begin{pmatrix} 1 & 4 \\ 4 & 21 \end{pmatrix}
\end{equation*}
Calculamos el paso de Newton $d^0 = -[\nabla^2 f(x^0)]^{-1} \nabla f(x^0)$:
\begin{equation*}
    d^0 = -\frac{1}{5} \begin{pmatrix} 1 & 4 \\ 4 & 21 \end{pmatrix} \begin{pmatrix} 9 \\ -2 \end{pmatrix} = -\frac{1}{5} \begin{pmatrix} 1 \\ -6 \end{pmatrix} = \begin{pmatrix} -0.2 \\ 1.2 \end{pmatrix}
\end{equation*}
El nuevo punto es $x^1 = x^0 + d^0 = (1.8, 3.2)^T$.

\textbf{3. Evaluación:}
$f(x^0) = \frac{1}{2}(4-2)^2 + \frac{1}{2}(-1)^2 = 2.5$.
$f(x^1) = \frac{1}{2}(1.8^2 - 3.2)^2 + \frac{1}{2}(1 - 1.8)^2 = \frac{1}{2}(0.04)^2 + \frac{1}{2}(-0.8)^2 = 0.3208$.
El decremento es muy grande, por lo que **sí es un excelente paso**.
\end{solution}

