\begin{exercise}
Para $f(x) = x^4 - x^2$, determine cuáles deben ser los puntos iniciales para que el método de Newton falle.
\end{exercise}

\begin{solution}
El método de Newton falla en dos escenarios principales:
\begin{enumerate}
    \item \textbf{Derivada nula (División por cero):}
    $f'(x_k) = 4x_k^3 - 2x_k = 0 \implies 2x_k(2x_k^2 - 1) = 0$. 
    Falla si $x_0 \in \left\{0, \frac{\sqrt{2}}{2}, -\frac{\sqrt{2}}{2}\right\}$.
    
    \item \textbf{Ciclo de oscilación ($x_{k+1} = -x_k$):}
    \begin{equation*}
        -x_k = x_k - \frac{x_k^4 - x_k^2}{4x_k^3 - 2x_k} \implies 2x_k = \frac{x_k(x_k^2 - 1)}{4x_k^2 - 2}
    \end{equation*}
    Dividiendo entre $x_k \neq 0$:
    \begin{equation*}
        2(4x_k^2 - 2) = x_k^2 - 1 \implies 8x_k^2 - 4 = x_k^2 - 1 \implies 7x_k^2 = 3
    \end{equation*}
    Falla si $x_0 = \pm \sqrt{\frac{3}{7}} \approx \pm 0.654$.
\end{enumerate}
\end{solution}

