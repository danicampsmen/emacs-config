<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Toggle Linea Oculta (H)</name>
    <id>org.tesis.castel.toggle_hidden</id>
    <effect><object-type>all</object-type><effects-menu><submenu name="Atajos Castel"/></effects-menu></effect>
    <script><command location="inx" interpreter="python">castel_hidden.py</command></script>
</inkscape-extension>