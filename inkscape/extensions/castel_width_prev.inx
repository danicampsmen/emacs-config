<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Ciclo Grosor Retroceder (Shift+W)</name>
    <id>org.tesis.castel.cycle_width_prev</id>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Atajos Castel"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">castel_width_prev.py</command>
    </script>
</inkscape-extension>
