{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "mpris", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "custom/audio-profile", "pulseaudio", "backlight", "battery", "custom/nightlight", "custom/ideapad", "tray", "custom/notification", "custom/power"],

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
    "tooltip-format": "Uso de CPU: {usage}%\nFrecuencia máx: {max_frequency} GHz\n• Clic: Abrir monitor de procesos (btop)",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM usada: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB\n• Clic: Abrir monitor de procesos (btop)",
    "states": {
      "warning": 80,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },

  "custom/notification": {
    "tooltip": true,
    "tooltip-format": "Centro de Control y Notificaciones\n• Clic izquierdo: Abrir / Cerrar\n• Clic derecho: Modo No Molestar",
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#ff6c6b'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#ff6c6b'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#ff6c6b'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#ff6c6b'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "▶ ",
      "spotify": " ",
      "firefox": "󰈹 ",
      "mpv": "🎵 "
    },
    "status-icons": {
      "paused": "⏸ "
    },
    "dynamic-order": ["title", "artist"],
    "dynamic-importance-order": ["title", "artist"],
    "dynamic-len": 32,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "tooltip-format": "Reproductor: {player}\nTítulo: {title}\nArtista: {artist}\nÁlbum: {album}\n\n• Clic: Play/Pausa\n• Clic der: Siguiente\n• Clic central: Anterior"
  },

  "custom/audio-profile": {
    "exec": "/home/fayfer/.config/hypr/scripts/audio-profile.sh --current",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Perfil de Audio actual\nClic izquierdo: Selector de perfiles\nClic derecho: Siguiente perfil",
    "on-click": "/home/fayfer/.config/hypr/scripts/audio-profile.sh",
    "on-click-right": "/home/fayfer/.config/hypr/scripts/audio-profile.sh --next",
    "signal": 1
  },

  "custom/nightlight": {
    "exec": "/home/fayfer/.config/hypr/scripts/nightlight.sh --status",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "tooltip": true,
    "on-click": "/home/fayfer/.config/hypr/scripts/nightlight.sh --menu",
    "on-click-right": "/home/fayfer/.config/hypr/scripts/nightlight.sh --toggle",
    "signal": 2
  },

  "custom/ideapad": {
    "exec": "/home/fayfer/.config/hypr/scripts/ideapad-controls.sh --status",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "tooltip": true,
    "on-click": "/home/fayfer/.config/hypr/scripts/ideapad-controls.sh --menu",
    "on-click-right": "/home/fayfer/.config/hypr/scripts/ideapad-controls.sh --toggle-conservation",
    "signal": 3
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Apagar / Suspender / Cerrar Sesión",
    "on-click": "wlogout -b 5 -T 450 -B 450 -L 150 -R 150"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name} {icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "󰈦",
      "4": "󰈹",
      "5": "󰭹",
      "urgent": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "on-click": "activate"
  },

  "hyprland/window": {
    "max-length": 40,
    "separate-outputs": true
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d %b | %H:%M}",
    "format-alt": "{:%A, %d de %B de %Y  |  Semana %V  |  %H:%M:%S}",
    "on-click": "/home/fayfer/.config/hypr/scripts/toggle-calendar.sh",
    "tooltip-format": "<tt><span size='11pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>\n<span size='9pt' color='#5c6370'>• Clic: Calendario GNOME / Google  • Rueda: Mes ±1  • Clic der: Vista  • Clic central: Hoy</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "iso8601": true,
      "format": {
        "months": "<span color='#51afef' size='11.5pt'><b>{}</b></span>",
        "weekdays": "<span color='#00d3d0'><b>{}</b></span>",
        "days": "<span color='#abb2bf'>{}</span>",
        "weeks": "<span color='#5c6370'><b>W{}</b></span>",
        "today": "<span color='#ffffff' background='#51afef'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-middle": "shift_reset",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "🔋 {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-plugged": "🔌 {capacity}%"
  },

  "backlight": {
    "format": "☀️ {percent}%",
    "on-scroll-up": "brightnessctl set 2%+",
    "on-scroll-down": "brightnessctl set 2%-",
    "on-click": "/home/fayfer/.config/hypr/scripts/brightness-profile.sh",
    "on-click-right": "/home/fayfer/.config/hypr/scripts/brightness-profile.sh --next",
    "tooltip": true,
    "tooltip-format": "Brillo de pantalla: {percent}%\n• Clic izquierdo: Selector de perfiles de brillo\n• Clic derecho: Siguiente perfil\n• Rueda del ratón: Ajuste fino (±2%)"
  },

  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 Mute",
    "on-click": "pavucontrol",
    "on-click-right": "/home/fayfer/.config/hypr/scripts/audio-profile.sh"
  },

  "tray": { "spacing": 10 }
}
