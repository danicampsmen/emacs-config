# ==================================================================
# --- 1. INTEGRACIÓN CON EMACS (SYNCTEX Y WAYLAND) ---
# ==================================================================
set synctex true
set synctex-editor-command "emacsclient -n +%{line} %{input}"

# Vital en Wayland: Permite copiar texto del PDF (con Ctrl+C o la tecla 'y')
# y poder pegarlo en Emacs o el navegador sin problemas.
set selection-clipboard clipboard

# ==================================================================
# --- 2. APARIENCIA ZEN (Basado en tus preferencias de EAF) ---
# ==================================================================
# Abrir siempre el PDF ajustado al ancho de la ventana (fit_to_width)
set adjust-open "width"

# Ocultar las barras de desplazamiento para un look más limpio
set guioptions ""

# Mostrar solo el nombre del archivo en la barra de título (sin rutas largas)
set window-title-basename true

# Suavizar el desplazamiento de página (scroll-step similar a tu EAF)
set scroll-step 40

# ============================================================
# --- 3. TEMA MODUS VIVENDI (WCAG AAA OLED Dark) ---
# ============================================================
# Mantener fondo blanco original de los PDFs (recolor desactivado)
set recolor                     false
set recolor-keephue             true

# Colores del Modo Oscuro / Recolor (Fondo negro OLED #000000, Tinta blanca nítida #ffffff)
set default-bg                  "#000000"
set default-fg                  "#ffffff"

set recolor-lightcolor          "#000000"
set recolor-darkcolor           "#e0e0e0"

# Barra de estado e ingreso de comandos (Bg-dim #1e1e1e)
set statusbar-bg                "#1e1e1e"
set statusbar-fg                "#ffffff"
set inputbar-bg                 "#1e1e1e"
set inputbar-fg                 "#ffffff"

# Notificaciones y advertencias
set notification-bg             "#1e1e1e"
set notification-fg             "#ffffff"
set notification-error-bg       "#1e1e1e"
set notification-error-fg       "#ff5f59"
set notification-warning-bg     "#1e1e1e"
set notification-warning-fg     "#cabf00"

# Completado y Selección
set highlight-color             "rgba(47, 175, 255, 0.35)"
set highlight-active-color      "rgba(0, 211, 208, 0.45)"
set completion-bg               "#1e1e1e"
set completion-fg               "#ffffff"
set completion-highlight-bg     "#2fafff"
set completion-highlight-fg     "#000000"

# ==================================================================
# --- 4. ATAJOS DE TECLADO EXTRA ---
# ==================================================================
# Tecla 'i' para invertir los colores (Modo claro/oscuro)
map i recolor

# Recargar el PDF manualmente con 'R' (aunque Zathura lo hace automático)
map R reload