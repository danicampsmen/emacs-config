# ==================================================================
# --- 1. INTEGRACIÓN CON EMACS (SYNCTEX Y WAYLAND) ---
# ==================================================================
set synctex true
set synctex-editor-command "emacsclient -n +%{line} %{input}"

# Vital en Wayland: Permite copiar texto del PDF (con Ctrl+C o la tecla 'y')
# y poder pegarlo en Emacs o el navegador sin problemas.
set selection-clipboard clipboard

# ==================================================================
# --- 2. APARIENCIA ZEN (Basado en tus preferencias de EAF) ---
# ==================================================================
# Abrir siempre el PDF ajustado al ancho de la ventana (fit_to_width)
set adjust-open "width"

# Ocultar las barras de desplazamiento para un look más limpio
set guioptions ""

# Mostrar solo el nombre del archivo en la barra de título (sin rutas largas)
set window-title-basename true

# Suavizar el desplazamiento de página (scroll-step similar a tu EAF)
set scroll-step 40

# ==================================================================
# --- 3. MODO OSCURO (Estilo Modus Vivendi) ---
# ==================================================================
# Descomenta la siguiente línea si quieres que los PDFs se abran en modo oscuro por defecto:
# set recolor true

# Colores del Modo Oscuro (Fondo gris muy oscuro, texto blanco/gris claro)
# Esto invierte los PDFs blancos para que no te cansen la vista de noche.
set recolor-lightcolor "#111111"  # Color de fondo de la hoja
set recolor-darkcolor  "#e0e0e0"  # Color de la tinta/texto

# Colores de la barra de estado y comandos para que combine con Emacs
set statusbar-bg       "#1e1e1e"
set statusbar-fg       "#ffffff"
set inputbar-bg        "#1e1e1e"
set inputbar-fg        "#ffffff"
set notification-bg    "#d3869b"  # Violeta suave (basado en tu font-latex)
set notification-fg    "#ffffff"
set notification-error-bg "#ff0000"
set notification-error-fg "#ffffff"

# ==================================================================
# --- 4. ATAJOS DE TECLADO EXTRA ---
# ==================================================================
# Tecla 'i' para invertir los colores (Modo claro/oscuro)
map i recolor

# Recargar el PDF manualmente con 'R' (aunque Zathura lo hace automático)
map R reload