# Zathura config - SyncTeX integration with Emacs
set synctex true
set synctex-editor-command "emacsclient -nw +%{line} %{input}"

set selection-clipboard clipboard

# Minimalist UI
set guioptions ""
set statusbar-h-padding 0
set statusbar-v-padding 0

# Increase page padding so page boundaries are clearer
set page-padding 12
set window-title-basename true
set statusbar-home-tilde true

# Dark palette and recolor settings - use a subtle, dark window background
set default-bg "#0b0b0b"
set default-fg "#dfdfdf"
set statusbar-bg "#121212"
set statusbar-fg "#dfdfdf"

# Recolor options: recolor the PDF content to improve contrast with the window.
# Toggle at runtime with ": set recolor true" / ": set recolor false" if needed.
set recolor true
set recolor-keephue false
set recolor-lightcolor "#ffffff"
set recolor-darkcolor "#e0e0e0"

# If the recolor plugin is not available in your build of zathura, disable
# recolor or compile zathura with the recolor plugin enabled. To quickly
# diagnose: open a PDF and run in zathura command mode:
#   :set recolor false
# then
#   :set default-bg #ffffff
# to see the original rendering.
