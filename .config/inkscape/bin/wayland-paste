#!/usr/bin/env python3
"""
Wayland Fast Paste & Clipboard Daemon for Inkscape
Mantiene un demonio de teclado virtual uinput persistente y maneja
el copiado al portapapeles y la emisión de Ctrl+V hacia Inkscape de forma instantánea.
"""

import os
import sys
import time
import socket
import threading
import subprocess
import evdev
from evdev import UInput, ecodes as e

SOCK_PATH = f"/run/user/{os.getuid()}/wayland-paste.sock"

class KeyboardServer:
    def __init__(self):
        cap = {
            e.EV_KEY: list(range(1, 248))
        }
        self.ui = UInput(events=cap, name='inkscape-math-keyboard')
        if os.path.exists(SOCK_PATH):
            try:
                os.unlink(SOCK_PATH)
            except OSError:
                pass
        
        self.server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server_sock.bind(SOCK_PATH)
        self.server_sock.listen(10)
        self.running = True

    def set_clipboard(self, text):
        if not text:
            return
        env = dict(os.environ)
        if 'WAYLAND_DISPLAY' not in env:
            env['WAYLAND_DISPLAY'] = 'wayland-0'
        if 'DISPLAY' not in env:
            env['DISPLAY'] = ':0'

        # Intentar wl-copy
        try:
            subprocess.run(['wl-copy', '--', text], env=env, timeout=1, check=False)
            return
        except Exception:
            pass

        # Fallback a xclip
        try:
            p = subprocess.Popen(['xclip', '-selection', 'clipboard'], stdin=subprocess.PIPE, env=env)
            p.communicate(input=text.encode('utf-8'), timeout=1)
        except Exception:
            pass

    def emit_paste_async(self, text=None):
        try:
            if text:
                self.set_clipboard(text)
            
            # Esperar a que la ventana de Emacs termine de desmontarse y el foco vuelva a Inkscape
            time.sleep(0.12)
            
            # Emitir Ctrl + V
            self.ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 1)
            self.ui.write(e.EV_KEY, e.KEY_V, 1)
            self.ui.syn()
            time.sleep(0.02)
            self.ui.write(e.EV_KEY, e.KEY_V, 0)
            self.ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 0)
            self.ui.syn()
        except Exception as ex:
            sys.stderr.write(f"Error emitiendo pulsación: {ex}\n")

    def handle_client(self, conn):
        try:
            conn.settimeout(0.5)
            data = b""
            while True:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
                if len(data) > 65536:
                    break
            
            msg = data.decode('utf-8', errors='ignore')
            
            # Responder y cerrar de inmediato
            try:
                conn.sendall(b"OK\n")
                conn.close()
            except Exception:
                pass

            text_to_paste = None
            if msg.startswith("PASTE:"):
                text_to_paste = msg[6:]
            elif msg.startswith("PASTE\n"):
                text_to_paste = msg[6:]
            elif msg == "PASTE" or not msg:
                text_to_paste = None
            elif msg == "STOP":
                self.running = False
                return

            t = threading.Thread(target=self.emit_paste_async, args=(text_to_paste,))
            t.daemon = True
            t.start()
        except Exception as ex:
            sys.stderr.write(f"Error en cliente: {ex}\n")
        finally:
            try:
                conn.close()
            except Exception:
                pass

    def run(self):
        while self.running:
            try:
                self.server_sock.settimeout(1.0)
                try:
                    conn, _ = self.server_sock.accept()
                except socket.timeout:
                    continue
                t = threading.Thread(target=self.handle_client, args=(conn,))
                t.daemon = True
                t.start()
            except Exception as ex:
                if self.running:
                    sys.stderr.write(f"Error en servidor: {ex}\n")
                break
        try:
            self.server_sock.close()
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
            self.ui.close()
        except Exception:
            pass

def send_command(cmd="PASTE", text=None):
    payload = cmd
    if text is not None:
        payload = f"PASTE:{text}"

    if os.path.exists(SOCK_PATH):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect(SOCK_PATH)
            s.sendall(payload.encode('utf-8'))
            s.shutdown(socket.SHUT_WR)
            s.close()
            return True
        except Exception:
            try:
                os.unlink(SOCK_PATH)
            except OSError:
                pass

    # Si no estuviese corriendo, iniciar el servidor
    import subprocess
    proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--server"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            start_new_session=True)
    for _ in range(15):
        time.sleep(0.02)
        if os.path.exists(SOCK_PATH):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(0.5)
                s.connect(SOCK_PATH)
                s.sendall(payload.encode('utf-8'))
                s.shutdown(socket.SHUT_WR)
                s.close()
                return True
            except Exception:
                pass
    return False

if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == "--server":
        server = KeyboardServer()
        server.run()
    elif len(sys.argv) > 1 and sys.argv[1] == "--start":
        if not os.path.exists(SOCK_PATH):
            import subprocess
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--server"],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,
                             start_new_session=True)
    else:
        text_arg = sys.argv[1] if len(sys.argv) > 1 else None
        send_command("PASTE", text_arg)
