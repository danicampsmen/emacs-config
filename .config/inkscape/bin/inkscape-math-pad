#!/usr/bin/env bash
# ==============================================================================
# Emacs Math Pad Launcher para Inkscape (Wayland / X11)
# ==============================================================================

unset DESKTOP_STARTUP_ID
unset XDG_ACTIVATION_TOKEN
unset STARTUP_ID

export TERM="xterm-256color"
export DISPLAY="${DISPLAY:-:0}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Si el servidor de Emacs no está corriendo, arrancar daemon silencioso
if ! emacsclient -e "(server-running-p)" >/dev/null 2>&1; then
    emacs --daemon >/dev/null 2>&1 &
    # Esperar brevemente a que el socket del daemon esté disponible
    for i in {1..20}; do
        if emacsclient -e "(server-running-p)" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
fi

# Pre-calentar el demonio de teclado virtual Wayland
if [ -x "$HOME/.local/bin/wayland-paste" ]; then
    "$HOME/.local/bin/wayland-paste" --start &
fi

# Lanzar marco flotante compacto enfocado en el Math Pad (no-wait para retorno instantáneo)
exec emacsclient -n -c \
    -F '((name . "inkscape-math-pad") (title . "Math Pad - Inkscape") (width . 90) (height . 5) (minibuffer . t) (menu-bar-lines . 0) (tool-bar-lines . 0) (vertical-scroll-bars . nil) (undecorated . nil) (z-group . above) (auto-raise . t))' \
    -e '(tesis-tools-open-math-pad)'
