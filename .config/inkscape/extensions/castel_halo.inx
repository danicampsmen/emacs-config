<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Toggle Halo Texto (B)</name>
    <id>org.tesis.castel.toggle_halo</id>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Atajos Castel"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">castel_halo.py</command>
    </script>
</inkscape-extension>
